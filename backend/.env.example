# Copia este archivo como backend/.env y completa los valores. El archivo .env no se sube a GitHub.

NODE_ENV=development
PUERTO=3000

# Conexión a PostgreSQL con el usuario obs_backend (ver backend/README.md).
# - Supabase local (supabase start): postgresql://obs_backend:<contraseña>@127.0.0.1:54322/postgres
# - Supabase en la nube: Panel > Connect > "Session pooler"; usuario obs_backend.<id-del-proyecto>
DATABASE_URL=
# En la nube de Supabase usa true.
DATABASE_SSL=false

# Secreto para firmar las sesiones: texto aleatorio de 32 caracteres o más.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=
JWT_EXPIRACION_HORAS=8

FRONTEND_URL=http://localhost:5173
API_URL_PUBLICA=http://localhost:3000
# Solo en servidor propio: carpeta del frontend compilado para servir la página desde esta API.
# FRONTEND_DIR=../frontend/dist

UPLOADS_DIR=uploads
UPLOADS_MAX_MB=4
# Supabase Storage (producción): URL del proyecto y llave secreta (Project Settings → API Keys). Bucket público.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=imagenes
# Anterior, solo en Vercel: Vercel Blob. Al conectar el almacenamiento, Vercel agrega BLOB_STORE_ID (OIDC). Vacío = carpeta UPLOADS_DIR.
BLOB_READ_WRITE_TOKEN=

# Correo. En desarrollo se usa Mailpit (buzón de prueba en http://localhost:8025).
# Déjalo vacío para que los correos solo se muestren en la consola.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=465, SMTP_SEGURO=true, SMTP_USUARIO=<cuenta>,
# SMTP_CONTRASENA=<contraseña de aplicación de 16 letras> y CORREO_REMITENTE con la misma cuenta.
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CONTRASENA=
CORREO_REMITENTE=Observatorio Empresarial <no-responder@uniempresarial.edu.co>

ALERTAS_ACTIVAS=true
# Solo en Vercel: secreto de Vercel Cron para GET /api/alertas/cron (texto aleatorio de 16+ caracteres).
CRON_SECRET=
ZONA_HORARIA=America/Bogota
