# Copia este archivo como despliegue/.env y completa los valores. Nunca lo subas a GitHub.
# Genera cada secreto con:  openssl rand -base64 36

# --- Base de datos (solo la usa Docker) ---
POSTGRES_PASSWORD=
# Contraseña del usuario con el que la aplicación entra a la base.
# Solo letras, números, - y _ (va dentro de la cadena de conexión).
OBS_BACKEND_PASSWORD=

# --- Aplicación ---
# Puerto del servidor en el que queda la plataforma (el proxy HTTPS apunta aquí).
PUERTO_PUBLICO=3000
# Dirección pública con https, sin "/" al final.
FRONTEND_URL=https://observatorio.uniempresarial.edu.co
API_URL_PUBLICA=https://observatorio.uniempresarial.edu.co

# Firma de las sesiones: texto aleatorio de 32 caracteres o más.
# Si cambia, todas las sesiones abiertas se cierran (no se pierde nada más).
JWT_SECRETO=
JWT_EXPIRACION_HORAS=8
UPLOADS_MAX_MB=4

# --- Correo (opcional; sin SMTP_HOST no se envían correos) ---
SMTP_HOST=
SMTP_PUERTO=465
SMTP_SEGURO=true
SMTP_USUARIO=
SMTP_CONTRASENA=
CORREO_REMITENTE=Observatorio Empresarial <observatorio@uniempresarial.edu.co>

# Alertas por correo programadas (cada 15 min y semanal). Sin correo configurado no hacen nada.
ALERTAS_ACTIVAS=true
ZONA_HORARIA=America/Bogota
