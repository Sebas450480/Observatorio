# Ejemplo de proxy HTTPS con nginx delante del Observatorio (contenedor en el puerto 3000).
# Copiar a /etc/nginx/sites-available/observatorio, ajustar server_name y certificados,
# enlazar en sites-enabled y recargar: sudo nginx -t && sudo systemctl reload nginx
# Certificado gratuito: sudo certbot --nginx -d observatorio.uniempresarial.edu.co

server {
    listen 80;
    server_name observatorio.uniempresarial.edu.co;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name observatorio.uniempresarial.edu.co;

    ssl_certificate     /etc/letsencrypt/live/observatorio.uniempresarial.edu.co/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/observatorio.uniempresarial.edu.co/privkey.pem;

    # Imágenes de hasta 4 MB más el resto del formulario.
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
